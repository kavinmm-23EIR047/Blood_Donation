# ========================================================
# FRONTEND APPLICATION CONFIGURATION TEMPLATE
# Copy this file to frontend/.env.local and adjust for your environment.
# ========================================================

# Next.js Server Port
PORT=3000

# Backend API Endpoint (used by Next.js API rewrites in next.config.js)
API_ORIGIN=http://localhost:4000

# Canonical Site URL (for public metadata and redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
