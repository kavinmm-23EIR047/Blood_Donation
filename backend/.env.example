# ========================================================
# BACKEND API SERVER TEMPLATE
# Copy this file to backend/.env and update values.
# ========================================================

# Server Port
PORT=4000

# MongoDB Connection String (Atlas Cluster or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/poongurichi_blood_network

# Secret Coordinator / Admin Access Passcode (replace with your secure key)
ADMIN_PASSCODE=replace-with-a-private-coordinator-passcode

# Allowed CORS Frontend Origin
CLIENT_ORIGIN=http://localhost:3000
